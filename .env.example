# Copie para .env.local em desenvolvimento. Na Vercel, cadastre cada variável em
# Settings → Environment Variables. As NEXT_PUBLIC_* são embutidas no build: depois
# de alterar qualquer uma delas, faça um novo deploy.

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
# Project Settings → API → chave anon (nos projetos novos: "Publishable")
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API → chave service_role (nos projetos novos: "Secret").
# Só no servidor; nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública do app, usada nos links de convite (em desenvolvimento: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Só para o Supabase CLI (pnpm db:link, db:push, db:types). Não cadastrar na Vercel.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=

# Só para o teste de fumaça Playwright (pnpm test:e2e): um usuário já criado no Supabase Auth.
E2E_EMAIL=
E2E_SENHA=
PLAYWRIGHT_BASE_URL=http://localhost:3000
